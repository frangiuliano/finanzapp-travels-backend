# Database (path after host is the database name — use `finanzapp`, not `finanzapp-travels`)
# Local:
MONGODB_URI=mongodb://localhost:27017/finanzapp
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/finanzapp

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=8080
NODE_ENV=development

# SPA origin for CORS (production: set to https://your-app.example.com, no trailing slash)
# Also used in transactional email links. See docs/branding-rename-checklist.md when changing hostnames.
FRONTEND_URL=http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
APP_NAME=FinanzApp

# Telegram bot (optional in local dev; required for link + expense flows)
# Production: fly secrets set TELEGRAM_BOT_TOKEN / WEBHOOK_URL / TELEGRAM_WEBHOOK_SECRET — never commit real tokens.
# Bot migration Travels → FinanzApp: docs/branding-rename-checklist.md + docs/adr/002-branding-rename-infra.md
TELEGRAM_BOT_TOKEN=
# Full URL to POST /api/bot/webhook (e.g. https://finanzapp-travels-backend.fly.dev/api/bot/webhook)
WEBHOOK_URL=
# Secret for Telegram webhook validation (generate with: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# LLM parser for Telegram (optional)
GROQ_API_KEY=

# FX provider (optional — without key, cross-currency expenses require fxRateOverride)
# Default provider: exchangerate-api.com (https://www.exchangerate-api.com/)
FX_API_KEY=
FX_API_BASE_URL=https://v6.exchangerate-api.com/v6
FX_CACHE_TTL_MS=3600000
